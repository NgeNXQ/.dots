{
    "scm.diffDecorations": "gutter",
    "git.decorations.enabled": true,
    "git.openRepositoryInParentFolders": "always",
    "update.mode": "none",
    "search.mode": "reuseEditor",
    "security.workspace.trust.enabled": false,
    "telemetry.telemetryLevel": "off",
    "window.zoomLevel": 2,
    "window.commandCenter": false,
    "window.titleBarStyle": "native",
    "window.menuBarVisibility": "toggle",
    "editor.tabSize": 4,
    "editor.folding": false,
    "editor.fontSize": 14,
    "editor.codeLens": false,
    "editor.indentSize": "tabSize",
    "editor.glyphMargin": false,
    "editor.cursorStyle": "block",
    "editor.formatOnSave": true,
    "editor.fontLigatures": true,
    "editor.matchBrackets": "never",
    "editor.smoothScrolling": true,
    "editor.colorDecorators": false,
    "editor.renderWhitespace": "trailing",
    "editor.snippetSuggestions": "none",
    "editor.renderLineHighlight": "line",
    "editor.overviewRulerBorder": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.experimentalWhitespaceRendering": "off",
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.guides.bracketPairsHorizontal": false,
    "editor.guides.highlightActiveIndentation": false,
    "editor.guides.highlightActiveBracketPair": false,
    "editor.minimap.enabled": false,
    "editor.suggest.showInlineDetails": false,
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 0,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.horizontalScrollbarSize": 0,
    "editor.lightbulb.enabled": "off",
    "editor.inlayHints.enabled": "off",
    "editor.stickyScroll.enabled": false,
    "editor.inlineSuggest.showToolbar": "never",
    "editor.inlineSuggest.syntaxHighlightingEnabled": true,
    "editor.bracketPairColorization.enabled": false,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "storage.type",
                    "storage.modifier",
                    "keyword.operator.new",
                    "keyword.operator.expression",
                    "variable.language.this",
                    "variable.language.super",
                ],
                "settings": {
                    "foreground": "#FB4934"
                }
            },
            {
                "scope": [
                    "storage.type.function.arrow",
                    "keyword.operator.logical",
                ],
                "settings": {
                    "foreground": "#8EC07C"
                }
            },
            {
                "scope": [
                    "storage.type.numeric",
                ],
                "settings": {
                    "foreground": "#D3869B"
                }
            },
            {
                "scope": [
                    "support.variable.property",
                ],
                "settings": {
                    "foreground": "#83A598"
                }
            }
        ]
    },
    "workbench.startupEditor": "none",
    "workbench.tree.indent": 20,
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.list.smoothScrolling": true,
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.showTabs": "none",
    "workbench.editor.enablePreview": false,
    "workbench.editor.navigationScope": "editor",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "workbench.sideBar.location": "right",
    "workbench.statusBar.visible": false,
    "workbench.activityBar.location": "hidden",
    "workbench.layoutControl.enabled": false,
    "breadcrumbs.symbolPath": "off",
    "debug.openDebug": "neverOpen",
    "debug.showInStatusBar": "never",
    "debug.toolBarLocation": "hidden",
    "debug.breakpointsView.presentation": "tree",
    "debug.enableStatusBarColor": false,
    "explorer.confirmDelete": false,
    "explorer.compactFolders": false,
    "explorer.excludeGitIgnore": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.autoOpenDroppedFile": false,
    "explorer.fileNesting.expand": false,
    "explorer.decorations.colors": false,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.confirmOnKill": "never",
    "terminal.integrated.hideOnStartup": "always",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.defaultLocation": "editor",
    "terminal.integrated.cursorStyleInactive": "none",
    "terminal.integrated.shellIntegration.showCommandGuide": false,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.commandsToSkipShell": [
        "search.action.openNewEditor",
        "workbench.view.scm",
        "workbench.view.explorer",
        "workbench.debug.action.toggleRepl",
        "workbench.action.increaseViewWidth",
        "workbench.action.decreaseViewWidth",
        "workbench.action.focusNextGroup",
        "workbench.action.focusPreviousGroup",
        "workbench.action.increaseViewHeight",
        "workbench.action.decreaseViewHeight",
        "workbench.action.createTerminalEditor",
        "workbench.action.moveEditorToLeftGroup",
        "workbench.action.moveEditorToRightGroup",
        "workbench.action.moveEditorToBelowGroup",
        "workbench.action.moveEditorToAboveGroup",
        "workbench.action.terminal.newWithProfile",
        "workbench.action.toggleAuxiliaryBar",
        "workbench.action.closeActiveEditor",
        "workbench.action.closeEditorsAndGroup",
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.toggleMaximizeEditorGroup",
        "workbench.action.output.toggleOutput",
        "workbench.actions.view.problems",
    ],
    "diffEditor.renderIndicators": false,
    "diffEditor.renderGutterMenu": false,
    "diffEditor.renderSideBySide": false,
    "diffEditor.renderMarginRevertIcon": false,
    "cSpell.language": "en, en-GB",
    "cSpell.diagnosticLevelFlaggedWords": "Information",
    "dbcode.ai.inlineCompletion": false,
    "color-highlight.matchWords": true,
    "color-highlight.markerType": "dot-before",
    "breakpointHighlight.backgroundColor": "#501c1cFF",
    "dotnetAcquisitionExtension.enableTelemetry": false,
    "errorLens.padding": "0 0.5ch 0.01ch 0.5ch",
    "errorLens.codeLensOnClick": "none",
    "errorLens.messageTemplate": "$severity $message",
    "errorLens.messageBackgroundMode": "message",
    "errorLens.severityText": [
        "■",
        "■",
        "■",
        "■",
    ],
    "custom-ui-style.external.loadStrategy": "cache",
    "custom-ui-style.font.sansSerif": "JetBrains Mono SemiBold",
    "custom-ui-style.font.monospace": "JetBrains Mono SemiBold",
    "custom-ui-style.electron": {
        "frame": false,
        "maxWidth": 2040,
        "maxHeight": 1144,
        "fullscreen": false,
        "transparent": true,
        "maximizable": false,
        "minimizable ": false,
        "fullscreenable": false,
        "backgroundColor": "#00000000",
        "backgroundMaterial": "acrylic",
    },
    "workbench.colorCustomizations": {
        "panel.background": "#000000FF",
        "input.background": "#00000000",
        "editor.background": "#0000004D",
        "editor.stackFrameHighlightBackground": "#50501CFF",
        "editor.focusedStackFrameHighlightBackground": "#1C501CFF",
        "sideBar.background": "#000000C2",
        "terminal.background": "#00000030",
        "dropdown.background": "#000000FF",
        "dropdown.listBackground": "#000000FF",
        "quickInput.background": "#00000050",
        "outputView.background": "#000000FF",
        "focusBorder": "#00000000",
        "sideBarTitle.background": "#00000000",
        "editorGutter.background": "#00000050",
        "editorGroupHeader.noTabsBackground": "#00000080",
        // "statusBar.border": "#00000000",
        // "statusBar.background": "#00000000",
        // "statusBar.focusBorder": "#00000000",
        // "statusBar.noFolderBackground": "#00000000",
        // "statusBar.debuggingBackground": "#00000000",
        // "statusBarItem.errorBackground": "#00000000",
        // "statusBarItem.activeBackground": "#00000000",
        // "statusBarItem.warningBackground": "#00000000",
        // "statusBarItem.compactBackground": "#00000000",
        // "statusBarItem.prominentBackground": "#00000000",
        // "statusBarItem.remoteHoverBackground": "#00000000",
    },
    "custom-ui-style.external.imports": [
        "file:///C:/Users/NgenX/AppData/Roaming/Code/User/settings.js",
        "file:///C:/Users/NgenX/AppData/Roaming/Code/User/settings.css",
    ],
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "workbench.iconTheme": "gruvbox-material-icons",
    "gruvbox-material-icons.folders.theme": "classic",
    "gruvbox-material-icons.hidesExplorerArrows": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
}